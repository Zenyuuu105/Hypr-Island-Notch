#!/usr/bin/env python3
"""lockclock - draws the lock-screen clock as a PNG (no fonts needed).

  lockclock          print path of a PNG showing the current time (12h, no leading zero)
  lockclock size     print the clock height in px for this screen (for hyprlock's image size)
  lockclock 4:44     print path of a PNG showing the given text (for testing)

Env: LOCKCLOCK_OPACITY (default 0.68)
"""
import base64, glob, json, os, struct, subprocess, sys, time, zlib

DATA = json.loads('''{"0": [312, 400, ""], "1": [212, 400, ""], "2": [304, 400, ""], "3": [312, 400, ""], "4": [348, 400, ""], "5": [312, 400, ""], "6": [312, 400, ""], "7": [312, 400, ""], "8": [312, 400, ""], "9": [312, 400, ""], ":": [117, 400, ""]}''')
GAP, CGAP, H = 25, 36, 400
OPACITY = float(os.environ.get("LOCKCLOCK_OPACITY", "0.68"))
OUT_DIR = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
if not os.path.isdir(OUT_DIR):
    OUT_DIR = "/tmp"

def glyph(ch):
    w, h, b64 = DATA[ch]
    return w, h, zlib.decompress(base64.b64decode(b64))

def render(text):
    parts, total = [], 0
    for i, ch in enumerate(text):
        w, h, raw = glyph(ch)
        if i:
            total += CGAP if (ch == ":" or text[i-1] == ":") else GAP
        parts.append((total, w, raw))
        total += w
    table = bytes(int(v*OPACITY) for v in range(256))
    rows = []
    for y in range(H):
        row = bytearray(total)
        for x0, w, raw in parts:
            row[x0:x0+w] = raw[y*w:(y+1)*w]
        a = bytes(row).translate(table)
        px = bytearray(4*total)
        px[0::4] = b"\xff"*total
        px[1::4] = b"\xff"*total
        px[2::4] = b"\xff"*total
        px[3::4] = a
        rows.append(b"\x00" + bytes(px))
    def chunk(t, d):
        c = struct.pack(">I", len(d)) + t + d
        return c + struct.pack(">I", zlib.crc32(t+d) & 0xffffffff)
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", total, H, 8, 6, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(b"".join(rows), 6))
    png += chunk(b"IEND", b"")
    return png

def path_for(text):
    return os.path.join(OUT_DIR, "lockclock-%s.png" % text.replace(":", "-"))

def make(text):
    p = path_for(text)
    if not os.path.exists(p):
        tmp = p + ".tmp"
        with open(tmp, "wb") as f:
            f.write(render(text))
        os.replace(tmp, p)
        for old in glob.glob(os.path.join(OUT_DIR, "lockclock-*.png")):
            if old != p and "test" not in old:
                try: os.remove(old)
                except OSError: pass
    return p

def screen_height():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3).stdout
        return int(json.loads(out)[0]["height"])
    except Exception:
        return 1080

def out(v):
    sys.stdout.write(v + ("\n" if sys.stdout.isatty() else ""))
    sys.stdout.flush()

def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "size":
        out(str(round(screen_height() * 0.2096))); return
    if arg:
        text = arg
    else:
        t = time.localtime()
        text = "%d:%02d" % (t.tm_hour % 12 or 12, t.tm_min)
    out(make(text))

if __name__ == "__main__":
    main()

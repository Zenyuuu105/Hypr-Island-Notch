#!/usr/bin/env bash

LOCK_ICON=$(printf "\xef\x80\xa3")
CLOCK_FONT="Nunito Black"          # after installing SF Compact Rounded, e.g. "SF Compact Rounded Black"
CLOCK_COLOR="rgba(255,255,255,0.70)"   # clip measured mint; try rgba(92,223,199,1.0)

WALLPAPER="$(awww query 2>/dev/null | sed -n 's/.*currently displaying: image: //p' | head -n1)"

if [[ -z "$WALLPAPER" || ! -f "$WALLPAPER" ]]; then
    WALLPAPER="$(find ~/Pictures/Wallpapers -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) 2>/dev/null | head -n1)"
fi

if [[ -z "$WALLPAPER" ]]; then
    echo "Could not find wallpaper."
    exit 1
fi

LOCKCLOCK_BIN="$HOME/.local/bin/lockclock"
CLOCK_IMG="$("$LOCKCLOCK_BIN")"
CLOCK_SIZE="$("$LOCKCLOCK_BIN" size)"
CLOCK_Y=$(( CLOCK_SIZE * 215 / 1000 ))

cat > ~/.config/hypr/hyprlock.conf <<EOF2
general {
    hide_cursor = true
}

animations {
    enabled = true
    bezier = easeOut, 0.16, 1, 0.3, 1
    bezier = linear, 1, 1, 0, 0
    animation = fadeIn, 1, 5, linear
    animation = fadeOut, 1, 5, linear
    animation = inputFieldWidth, 1, 6, easeOut
    animation = inputFieldDots, 1, 2, linear
}

background {
    monitor =
    path = $WALLPAPER
    blur_passes = 1
    blur_size = 3
    noise = 0.008
    vibrancy = 0.12
    brightness = 0.88
    contrast = 1.0
}

# CLOCK (drawn image, no font)
image {
    monitor =
    path = $CLOCK_IMG
    size = $CLOCK_SIZE
    rounding = 0
    border_size = 0
    reload_time = 1
    reload_cmd = $LOCKCLOCK_BIN
    position = 0, -$CLOCK_Y
    halign = center
    valign = center
}

# LOCK PILL (top): lock icon when empty, dots while typing
input-field {
    monitor =
    size = 64, 44
    rounding = -1
    outline_thickness = 0
    inner_color = rgba(0, 0, 0, 0.55)
    outer_color = rgba(0, 0, 0, 0)
    font_color = rgba(255, 255, 255, 0.90)
    check_color = rgba(255, 255, 255, 0.90)
    fail_color = rgba(255, 107, 107, 0.95)
    dots_size = 0.22
    dots_spacing = 0.30
    dots_center = true
    dots_rounding = -1
    fade_on_empty = false
    placeholder_text = <span font_family="Symbols Nerd Font" font_size="xx-large" foreground="##ffffffcc">$LOCK_ICON</span>
    fail_text = <i>\$FAIL</i>
    hide_input = false
    position = 0, -40
    halign = center
    valign = top
}
EOF2

[[ -n "$LOCK_DRY" ]] && exit 0

exec hyprlock
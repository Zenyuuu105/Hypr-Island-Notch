#!/usr/bin/env python3
import json, os, sys
name, mode, scale = sys.argv[1], sys.argv[2], sys.argv[3]
d = os.path.expanduser("~/.config/hypr/modules")
js = os.path.join(d, "panel-displays.json")
lua = os.path.join(d, "panel-displays.lua")
try:
    data = json.load(open(js))
except Exception:
    data = {}
data[name] = {"mode": mode, "scale": float(scale)}
json.dump(data, open(js, "w"), indent=2)
out = ["-- Generated by the dotarch Display panel. Manual edits may be overwritten.", ""]
for n, v in data.items():
    out += ["hl.monitor({", "    output = \"%s\"," % n, "    mode = \"%s\"," % v["mode"], "    position = \"auto\",", "    scale = %s," % v["scale"], "})", ""]
open(lua, "w").write("\n".join(out))


[general]
bars = 12
framerate = 30
autosens = 1

[input]
method = pulse
source = alsa_output.pci-0000_00_1b.0.analog-stereo.monitor

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10
channels = mono

[smoothing]
noise_reduction = 65

# Generated by 43pr theme.py from ~/.config/43pr/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#e6eaf2"

# Title color for boxes
theme[title]="#ffffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ffffff"

# Background and foreground color for selected item in processes box
theme[selected_bg]="#242832"
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#4a4a4a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#7aa2f7"

# Box outline and divider line colors
theme[cpu_box]="#2a2a2a"
theme[mem_box]="#2a2a2a"
theme[net_box]="#2a2a2a"
theme[proc_box]="#2a2a2a"
theme[div_line]="#2a2a2a"

# Temperature graph colors
theme[temp_start]="#8b93a7"
theme[temp_mid]="#f7768e"
theme[temp_end]="#ff003c"

# CPU graph colors
theme[cpu_start]="#6f6f6f"
theme[cpu_mid]="#c2c2c2"
theme[cpu_end]="#ffffff"

# Mem/Disk free meter
theme[free_start]="#6f6f6f"
theme[free_mid]="#8b93a7"
theme[free_end]="#00ff9c"

# Mem/Disk cached meter
theme[cached_start]="#6f6f6f"
theme[cached_mid]="#8b93a7"
theme[cached_end]="#7aa2f7"

# Mem/Disk available meter
theme[available_start]="#6f6f6f"
theme[available_mid]="#8b93a7"
theme[available_end]="#c2c2c2"

# Mem/Disk used meter
theme[used_start]="#6f6f6f"
theme[used_mid]="#c2c2c2"
theme[used_end]="#ffffff"

# Download graph colors
theme[download_start]="#6f6f6f"
theme[download_mid]="#8b93a7"
theme[download_end]="#7aa2f7"

# Upload graph colors
theme[upload_start]="#6f6f6f"
theme[upload_mid]="#8b93a7"
theme[upload_end]="#ffffff"

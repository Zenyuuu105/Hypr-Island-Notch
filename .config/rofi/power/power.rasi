configuration {
    show-icons: false;
    display-drun: "Apps";
}

* {
    bg: #21252b;
    bg-alt: #2c313a;
    fg: #abb2bf;
    red: #e06c75;
    blue: #61afef;
    border-color: #3e4451;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    width: 340px;
    border: 1px;
    border-color: @border-color;
    border-radius: 18px;
    background-color: @bg;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    spacing: 8px;
    children: [ "message", "listview" ];
}

message {
    background-color: transparent;
    padding: 8px;
}

textbox {
    text-color: @fg;
    background-color: transparent;
}

listview {
    lines: 4;
    fixed-height: true;
    background-color: transparent;
    spacing: 6px;
    scrollbar: false;
}

element {
    padding: 12px;
    border-radius: 12px;
    background-color: @bg-alt;
    text-color: @fg;
}

element selected {
    background-color: @red;
    text-color: @bg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
